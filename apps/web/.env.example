# NextAuth (Auth.js v5) Discord OAuth
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# Discord Application credentials (Developer Portal → OAuth2)
# Reuse the bot's Application ID; secret is from "OAuth2 → Reset Secret"
AUTH_DISCORD_ID=your_discord_application_id
AUTH_DISCORD_SECRET=your_discord_oauth_secret

# For local dev. Auth.js auto-detects in production from VERCEL_URL.
NEXTAUTH_URL=http://localhost:3000

# Required Discord OAuth2 redirect URI (set in Developer Portal):
#   http://localhost:3000/api/auth/callback/discord       (dev)
#   https://<your-vercel-url>/api/auth/callback/discord   (prod)
